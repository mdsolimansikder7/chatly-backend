PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chatly
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Required for signup: the mailbox owner must use the emailed link (expires in 1 hour)
# Unverified users can request another link from signup or sign-in.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-your-smtp-password-or-app-password
EMAIL_FROM="Chatly <mailer@example.com>"
