PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chatly
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Optional explicit public API URL; Render can use its RENDER_EXTERNAL_URL.
API_BASE_URL=https://your-backend.example.com

# Configure one or both OAuth providers in their developer consoles.
# Register callback URLs:
# https://your-backend.example.com/api/auth/google/callback
# https://your-backend.example.com/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=
